import { ReactNode, useMemo, useState, useRef, useEffect } from 'react';
import { Paper } from '@mantine/core';
import { uniqueId } from 'lodash';
import {
  useArchbaseRemoteServiceApi,
  useArchbaseRemoteDataSourceV2,
  useArchbaseStore
} from '@archbase/data';
import {
  ArchbaseDialog,
  ArchbaseNotifications,
  useArchbaseNavigateParams,
  ArchbaseDataGridColumn,
  ArchbaseGridRowActions,
  Columns,
  useArchbaseElementSizeArea
} from '@archbase/components';
import {
  ArchbaseGridTemplateRef,
  ArchbaseGridTemplate,
  UserRowActionsOptions
} from '@archbase/template';
import { useArchbaseNavigationListener } from '@archbase/admin';
import { ArchbaseViewSecurityProvider, useArchbaseSecureForm } from '@archbase/security';
{{#if typescript}}
import { {{entityName}}Dto } from '../../domain/{{entityName}}Dto';
import { {{entityName}}Service } from '../../services/{{entityName}}Service';
import { API_TYPE } from '../../ioc/IOCTypes';
{{/if}}

// Constantes de segurança (padrão canônico Archbase V3)
const SECURITY_RESOURCE_NAME = '{{toLowerCase entityName}}';
const SECURITY_RESOURCE_DESCRIPTION = '{{entityName}}';

// Constante de navegação
const {{featureConstant}}_ROUTE = '{{adminRoute}}';

// Constantes de ações
const ADD_ACTION = 'ADD';
const EDIT_ACTION = 'EDIT';
const VIEW_ACTION = 'VIEW';

export function {{componentName}}() {
  return (
    <ArchbaseViewSecurityProvider
      resourceName={SECURITY_RESOURCE_NAME}
      resourceDescription={SECURITY_RESOURCE_DESCRIPTION}
    >
      <{{componentName}}Content />
    </ArchbaseViewSecurityProvider>
  );
}

function {{componentName}}Content() {
{{#if withPermissions}}
  const { canCreate, canEdit, canDelete, canView, isLoading: isLoadingSecurity } = useArchbaseSecureForm(
    SECURITY_RESOURCE_NAME,
    SECURITY_RESOURCE_DESCRIPTION
  );
{{else}}
  const { isLoading: isLoadingSecurity } = useArchbaseSecureForm(
    SECURITY_RESOURCE_NAME,
    SECURITY_RESOURCE_DESCRIPTION
  );
{{/if}}

  const templateStore = useArchbaseStore('{{toLowerCase entityName}}Store');
  const { closeAllowed } = useArchbaseNavigationListener({{featureConstant}}_ROUTE, () => {
    templateStore.clearAllValues();
    closeAllowed();
  });
  const navigate = useArchbaseNavigateParams();
  const serviceApi = useArchbaseRemoteServiceApi<{{entityName}}Service>(API_TYPE.{{entityName}});
  const [lastError, setLastError] = useState<string>('');
  const [containerRef, { height: containerHeight }] = useArchbaseElementSizeArea();
  const templateRef = useRef<ArchbaseGridTemplateRef | null>(null);

  const {
    dataSource,
    currentRecord,
    isLoading,
    error,
    refreshData,
    remove
  } = useArchbaseRemoteDataSourceV2<{{entityName}}Dto>({
    name: 'ds{{entityName}}',
    label: '{{entityName}}',
    service: serviceApi,
    pageSize: {{pageSize}},
    defaultSortFields: ['id'],
    onError: (err) => {
      ArchbaseNotifications.showError('Atenção', err);
      setLastError(String(err));
    }
  });

  useEffect(() => {
    refreshData();
  }, [refreshData]);

  const handleAdd = () => {
    navigate(
      `${ {{~featureConstant}}_ROUTE}/novo->${uniqueId()}`,
      {},
      { action: ADD_ACTION, redirectUrl: {{featureConstant}}_ROUTE }
    );
  };

  const handleEdit = (row?: {{entityName}}Dto) => {
    const record = row || currentRecord;
    if (record) {
      if (row) {
        dataSource.gotoRecordByData(row);
      }
      navigate(
        `${ {{~featureConstant}}_ROUTE}/${record.id}`,
        {},
        { action: EDIT_ACTION, redirectUrl: {{featureConstant}}_ROUTE }
      );
    }
  };

  const handleView = (row?: {{entityName}}Dto) => {
    const record = row || currentRecord;
    if (record) {
      if (row) {
        dataSource.gotoRecordByData(row);
      }
      navigate(
        `${ {{~featureConstant}}_ROUTE}/${record.id}`,
        {},
        { action: VIEW_ACTION, redirectUrl: {{featureConstant}}_ROUTE }
      );
    }
  };

  const handleRemove = (row?: {{entityName}}Dto) => {
    const record = row || currentRecord;
    if (record) {
      if (row) {
        dataSource.gotoRecordByData(row);
      }
      ArchbaseDialog.showConfirmDialogYesNo(
        'Confirme',
        'Deseja remover este registro?',
        () => {
          remove();
        },
        () => {}
      );
    }
  };

  const getRowId = (row: {{entityName}}Dto): string => {
    return row.id || '';
  };

  const handleClearError = () => {
    setLastError('');
  };

  const columns: ReactNode = useMemo(() => {
    return (
      <Columns>
{{#each fields}}
        <ArchbaseDataGridColumn<{{../entityName}}Dto>
          dataField="{{name}}"
          dataType="{{#if (eq type 'enum')}}enum{{else if (eq type 'date')}}date{{else if (eq type 'datetime')}}datetime{{else if (eq type 'number')}}number{{else if (eq type 'boolean')}}boolean{{else}}text{{/if}}"
          header="{{label}}"
{{#if filterable}}          inputFilterType="{{#if (eq type 'enum')}}select{{else if (eq type 'date')}}date-range{{else if (eq type 'datetime')}}date-range{{else if (eq type 'number')}}number{{else}}text{{/if}}"
{{/if}}{{#if size}}          size={{lt}}{{size}}{{gt}}
{{else if width}}          size={{lt}}{{width}}{{gt}}
{{/if}}{{#unless sortable}}          enableSorting={false}
{{/unless}}        />
{{/each}}
      </Columns>
    );
  }, []);

  const userRowActions: UserRowActionsOptions<{{entityName}}Dto> = {
    actions: ArchbaseGridRowActions,
    onAddRow: {{#if withPermissions}}canCreate ? handleAdd : undefined{{else}}handleAdd{{/if}},
    onEditRow: {{#if withPermissions}}canEdit ? handleEdit : undefined{{else}}handleEdit{{/if}},
    onRemoveRow: {{#if withPermissions}}canDelete ? handleRemove : undefined{{else}}handleRemove{{/if}},
    onViewRow: {{#if withPermissions}}canView ? handleView : undefined{{else}}handleView{{/if}}
  };

  if (isLoadingSecurity) {
    return null;
  }

  return (
    <Paper p="md" style={{lt}}{{lt}} height: '100%', display: 'flex', flexDirection: 'column' {{gt}}{{gt}}>
      <Paper ref={containerRef} withBorder style={{lt}}{{lt}} flex: 1, minHeight: 0, overflow: 'hidden' {{gt}}{{gt}}>
        <ArchbaseGridTemplate<{{entityName}}Dto, string>
          ref={templateRef}
          title="{{entityName}}"
          height={containerHeight}
          width={'100%'}
          dataSource={dataSource}
          pageSize={{lt}}{{pageSize}}{{gt}}
          isLoading={isLoading}
          error={error || lastError}
          isError={!!error || lastError !== ''}
          clearError={handleClearError}
          withBorder={false}
{{#if withFilters}}          filterType={'normal'}
          filterOptions={{lt}}{{lt}}
            activeFilterIndex: 0,
            enabledAdvancedFilter: false,
            apiVersion: '2.00',
            componentName: '{{toLowerCase entityName}}Filter',
            viewName: '{{componentName}}'
          {{gt}}{{gt}}
{{/if}}          userActions={{lt}}{{lt}}
            visible: true,
            allowRemove: {{#if withPermissions}}canDelete{{else}}true{{/if}},
            onAddExecute: {{#if withPermissions}}canCreate ? handleAdd : undefined{{else}}handleAdd{{/if}},
            onEditExecute: {{#if withPermissions}}canEdit ? handleEdit : undefined{{else}}handleEdit{{/if}},
            onRemoveExecute: {{#if withPermissions}}canDelete ? handleRemove : undefined{{else}}handleRemove{{/if}},
            onViewExecute: {{#if withPermissions}}canView ? handleView : undefined{{else}}handleView{{/if}}
          {{gt}}{{gt}}
          userRowActions={userRowActions}
          getRowId={getRowId}
          enableTopToolbarActions={true}
          enableRowSelection={true}
          enableRowActions={true}
          columns={columns}
          positionActionsColumn={'first'}
        />
      </Paper>
    </Paper>
  );
}

export default {{componentName}};
