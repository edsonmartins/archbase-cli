import React, { useCallback } from 'react';
import {
{{#each formEditorImports}}
  {{this}},
{{/each}}
} from '@archbase/components';
import { ArchbaseFormTemplate } from '@archbase/template';
import {
  useArchbaseRemoteDataSource,
  useArchbaseRemoteServiceApi,
  useArchbaseStore
} from '@archbase/data';
import { useArchbaseValidator } from '@archbase/core';
import { useParams, useSearchParams } from 'react-router-dom';
import { {{entityName}}Dto } from '../../domain/{{entityName}}Dto';
import { {{entityName}}Service } from '../../services/{{entityName}}Service';
import { API_TYPE } from '../../ioc/{{iocTypesName}}';
{{#each enumImports}}
{{{this}}}
{{/each}}

// Validation is driven by the DTO's class-validator decorators via
// useArchbaseValidator() below (the V3 pattern), not a standalone schema.

export function {{componentName}}() {
  const { {{toLowerCase entityName}}Id } = useParams{{#if typescript}}<{ {{toLowerCase entityName}}Id: string }>{{/if}}();
  const [searchParamsUrl] = useSearchParams();
  const action = (searchParamsUrl.get('action') ?? 'ADD').toUpperCase();
  const isAddAction = action === 'ADD';
  const isViewAction = action === 'VIEW';

  const templateStore = useArchbaseStore(`{{toLowerCase entityName}}Form${ {{toLowerCase entityName}}Id }Store`);
  const serviceApi = useArchbaseRemoteServiceApi<{{entityName}}Service>(API_TYPE.{{entityName}});
  const validator = useArchbaseValidator();

  const { dataSource, isLoading } = useArchbaseRemoteDataSource<{{entityName}}Dto, string>({
    name: `ds{{entityName}}${ {{toLowerCase entityName}}Id }`,
    label: '{{entityName}}',
    service: serviceApi,
    store: templateStore,
    pageSize: 50,
    loadOnStart: !isAddAction,
    validator,
    id: action === 'EDIT' || isViewAction ? {{toLowerCase entityName}}Id : undefined,
    onLoadComplete: (ds) => {
      if (isAddAction) {
        ds.insert({{entityName}}Dto.newInstance());
      }
    }
  });

  const handleAfterSave = useCallback(() => {
    templateStore.clearAllValues();
  }, [templateStore]);

  return (
    <ArchbaseFormTemplate
      title={isAddAction ? 'Novo {{entityName}}' : isViewAction ? 'Visualizar {{entityName}}' : 'Editar {{entityName}}'}
      dataSource={dataSource}
      onAfterSave={handleAfterSave}
      isLoading={isLoading}
      readOnly={isViewAction}
    >
      {{> formFields}}
    </ArchbaseFormTemplate>
  );
}

export default {{componentName}};
